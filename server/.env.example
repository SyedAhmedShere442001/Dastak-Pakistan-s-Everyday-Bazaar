# ------------------------------------------------------------------
# Dastak API environment
# Copy this file to `.env` and adjust the values.
# ------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Use a local MongoDB (mongodb://127.0.0.1:27017/dastak) or MongoDB Atlas.
# Leave this blank to automatically run a persistent local MongoDB
# instance via mongodb-memory-server (stored in server/.data/mongo).
MONGODB_URI=
MONGODB_DB=dastak

# Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Allowed browser origin for CORS (Vite dev server by default).
CLIENT_URL=http://localhost:5173

# Delivery pricing in PKR.
SHIPPING_FLAT=250
FREE_SHIPPING_THRESHOLD=5000

# Seed the demo catalog automatically when the database is empty.
AUTO_SEED=true
